{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "norselift-landing",
  "compatibility_date": "2026-10-01",
  // Static-only site: no Worker script, Cloudflare serves the repo root as assets.
  "assets": {
    "directory": ".",
    // Same canonical URLs as Vercel cleanUrls: /terms (terms.html), /blog (blog/index.html)
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "preview_urls": true,
  // Apex is served by this Worker as a Custom Domain (attached at cutover, 21 Oct 2026).
  // Declared here so `wrangler deploy` (Workers Builds) keeps it attached.
  // www -> apex 308 redirect is a zone Redirect Rule (see CLOUDFLARE_MIGRATION.md), not a route.
  "routes": [
    { "pattern": "norselift.com", "custom_domain": true }
  ]
}
